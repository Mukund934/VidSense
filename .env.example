# VidSense AI — environment template. Copy to .env.local and fill in.
# NEVER commit .env.local. Values here must stay empty.

# --- Gemini (server-only, never NEXT_PUBLIC) ---
# Create in Google AI Studio. Must be an AUTH key — standard keys are rejected from September 2026.
# If both are set, GOOGLE_API_KEY takes precedence over GEMINI_API_KEY.
GEMINI_API_KEY=

# --- YouTube Data API v3 (server-only) ---
# API key covers public metadata + comments. captions.list needs OAuth instead.
YOUTUBE_API_KEY=

# --- Google OAuth (only needed for the captions experiment and, later, creator mode) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/callback

# --- Firebase web config (publishable by design; safety comes from Rules + App Check) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server-only) ---
# Path to a service-account JSON file kept OUTSIDE the repo, or the JSON inline.
FIREBASE_SERVICE_ACCOUNT_PATH=

# --- Local development ---
# When 1, the app talks to the Firebase emulator suite instead of live Firestore.
USE_FIREBASE_EMULATOR=1
