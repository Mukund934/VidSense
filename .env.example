# VidSense AI — environment template. Copy to .env.local and fill in.
# NEVER commit .env.local. Values here must stay empty.

# --- Gemini (server-only, never NEXT_PUBLIC) ---
# Create in Google AI Studio. Must be an AUTH key — standard keys are rejected from September 2026.
# If both are set, GOOGLE_API_KEY takes precedence over GEMINI_API_KEY.
GEMINI_API_KEY=

# --- YouTube Data API v3 (server-only) ---
# API key covers public metadata + comments. captions.list needs OAuth instead.
YOUTUBE_API_KEY=

# --- Google OAuth ---
# NOT required. v1 uses public API-key calls only and ships no YouTube OAuth at
# all. These exist for one optional feasibility experiment (`captions.list` on a
# video you do not own) and nothing else reads them. Leave them empty.
# GOOGLE_CLIENT_SECRET is deliberately absent: no code path performs a token
# exchange, so asking for it would widen the credential surface for nothing.
GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/callback

# --- Firebase web config (publishable by design; safety comes from Rules + App Check) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server-only) ---
# Either a path to a service-account JSON file kept OUTSIDE the repo, or the
# JSON itself. A value starting with `{` is read as the credential, which is the
# only form that works on a serverless host — there is nowhere to put a file.
FIREBASE_SERVICE_ACCOUNT_PATH=

# --- Answer verification (gate 3) ---
# When 1, every cited claim is checked against its own quote before the answer
# is returned, and a citation that does not support its claim loses its receipt.
# Costs roughly one extra model call per claim, so it is off by default.
# Measured 2026-09-08: 0 false positives on 15 definitively-true citations.
VERIFY_ANSWERS=0

# --- Per-user limits ---
# The free tiers are shared across every user at once: Gemini's YouTube-URL path
# allows about 8 hours of video a day for the WHOLE project, not per person. All
# four have defaults; set them only to tighten as the number of users grows.
# A malformed value falls back to the default rather than meaning "no limit".
INGESTS_PER_DAY=
ASKS_PER_DAY=
# Seconds of video one user may send in a day. A count of videos cannot bound
# this on its own, because one video may be two and a half hours long.
VIDEO_SECONDS_PER_DAY=
INGESTS_PER_MINUTE=
ASKS_PER_MINUTE=

# --- The deployment ceiling ---
# Per-user caps bound one person; a signed-out identity is a cookie, so they do
# not bound ten people or one person with ten cookie jars. These count the whole
# deployment, once, and are the last line before the provider's own limit.
# Seconds is the binding one: ARCHITECTURE §6 records the Gemini free tier at
# about 8 hours of YouTube video a day FOR THE WHOLE PROJECT. The default is 7,
# leaving margin, and raising it also raises how many ingests can run at once.
DEPLOYMENT_VIDEO_SECONDS_PER_DAY=
DEPLOYMENT_INGESTS_PER_DAY=
DEPLOYMENT_ASKS_PER_DAY=

# --- Deployment ---
# The public origin, with no trailing slash. Needed by link previews and
# robots.txt, neither of which sees a request header. On Vercel the project's
# production URL is used when this is unset. Left empty locally, which makes
# robots.txt disallow everything — the right answer for a preview URL.
NEXT_PUBLIC_SITE_URL=

# Authorises the daily retention sweep at /api/maintenance/sweep, which deletes
# the video knowledge whose thirty-day window has closed. Vercel sends it as
# `Authorization: Bearer $CRON_SECRET` on the schedule in vercel.json.
# WITHOUT THIS THE SWEEP REFUSES TO RUN, and nothing enforces retention.
# Generate one: openssl rand -base64 32
CRON_SECRET=

# --- Local development ---
# When 1, the app talks to the Firebase emulator suite instead of live Firestore.
USE_FIREBASE_EMULATOR=1
